{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "dist/types",
    "rootDir": "../..",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src",
    "../../boats/*.json",
    "../../courses/*/course.json",
    "../../courses/*/starts.json",
    "../../courses/*/times.json",
    "src/data/*.json",
    "../../courses/*/places.json",
    "../../courses/*/races.json"
  ],
  "references": [
    {
      "path": "../../packages/sim"
    },
    {
      "path": "../../packages/world"
    },
    {
      "path": "../../packages/nav"
    }
  ]
}